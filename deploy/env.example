# Absolute path owned by the user running Docker Compose.
JPJOBS_DATA_DIR=/home/your-user/.local/share/jpjobs

# Match the owner of JPJOBS_DATA_DIR (`id -u` and `id -g`).
JPJOBS_UID=1000
JPJOBS_GID=1000

# Daily schedule in Asia/Tokyo.
JPJOBS_SCHEDULE_HOUR=3
JPJOBS_SCHEDULE_MINUTE=15
# Optional KIKKAKE Cloudflare ingest. Leave both empty to disable product sync.
KIKKAKE_INGEST_URL=https://kikkake-web-staging.podnote-api.workers.dev
KIKKAKE_INGEST_SECRET=replace-with-the-same-32-byte-secret-as-INGEST_HMAC_SECRET
